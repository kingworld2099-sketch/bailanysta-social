generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Vibe {
  MOVE
  CALM
  DRAINED
  WORK
}

enum ConnectStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  name          String
  lastName      String?
  city          String
  occupation    String?
  bio           String?
  contact       String?
  passwordHash  String
  vibe          Vibe     @default(CALM)
  vibeUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  seenProfileTour Boolean   @default(false)
  seenFeedTour    Boolean   @default(false)
  lastSeenLikesAt DateTime?
  headerIconsSide String    @default("right")

  posts    Post[]
  likes    Like[]
  comments Comment[]
  commentLikes CommentLike[]

  sentRequests     ConnectRequest[] @relation("SentRequests")
  receivedRequests ConnectRequest[] @relation("ReceivedRequests")
  messages         Message[]

  blocksMade    Block[] @relation("BlocksMade")
  blocksAgainst Block[] @relation("BlocksAgainst")

  reportsFiled    Report[] @relation("ReportsFiled")
  reportsReceived Report[] @relation("ReportsReceived")

  @@index([city, vibe, vibeUpdatedAt])
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  text      String
  vibe      Vibe
  place     String?
  plannedAt String?
  photoUrl  String?
  createdAt DateTime @default(now())

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]
  connectRequests ConnectRequest[]

  @@index([vibe, createdAt])
  @@index([authorId, createdAt])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(uuid())
  authorId  String
  postId    String
  text      String
  createdAt DateTime @default(now())

  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes  CommentLike[]
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model ConnectRequest {
  id        String        @id @default(uuid())
  fromUserId String
  toUserId   String
  postId     String
  status     ConnectStatus @default(PENDING)
  fromTrusts Boolean       @default(false)
  toTrusts   Boolean       @default(false)
  fromLastReadAt DateTime?
  toLastReadAt   DateTime?
  createdAt  DateTime      @default(now())
  expiresAt  DateTime?

  fromUser User @relation("SentRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ReceivedRequests", fields: [toUserId], references: [id], onDelete: Cascade)
  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([fromUserId, postId])
  @@index([toUserId, status])
}

model Message {
  id        String   @id @default(uuid())
  requestId String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  request ConnectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksAgainst", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  context        String
  reason         String?
  createdAt      DateTime @default(now())

  reporter     User @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId, createdAt])
}
