generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Vibe {
  MOVE
  CALM
  DRAINED
  WORK
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  name          String
  city          String
  occupation    String?
  bio           String?
  contact       String?
  passwordHash  String
  vibe          Vibe     @default(CALM)
  vibeUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  posts    Post[]
  likes    Like[]
  comments Comment[]

  @@index([city, vibe, vibeUpdatedAt])
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  text      String
  vibe      Vibe
  place     String?
  plannedAt String?
  photoUrl  String?
  createdAt DateTime @default(now())

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]

  @@index([vibe, createdAt])
  @@index([authorId, createdAt])
}

model Like {
  id     String @id @default(uuid())
  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(uuid())
  authorId  String
  postId    String
  text      String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}
